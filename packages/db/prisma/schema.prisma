// Schéma de la base PostgreSQL.
// Explication en mots simples : docs/BASE_DE_DONNEES.md
// Rappel : uniquement des données fictives en développement.
//
// Règles de suppression :
// - Supprimer un patient supprime tout ce qui le concerne (programmes, réalisations,
//   enregistrements, séances, bilans, conseils envoyés, messages, liens tuteurs).
// - Le journal d'accès n'a volontairement AUCUNE clé étrangère : il survit à la
//   suppression d'un patient ou d'un compte (traçabilité).
// - Un cabinet, une catégorie ou un exercice encore utilisés ne peuvent pas être
//   supprimés (Restrict) : on évite les effacements massifs par erreur.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Énumérations ────────────────────────────────────────────────────────────

enum Role {
  ORTHO
  PARENT
  PATIENT_ADULT
}

enum TypeConsentement {
  CONDITIONS_UTILISATION
  DONNEES_SANTE
  MESSAGERIE
  ENREGISTREMENT_AUDIO
}

enum JourSemaine {
  LUNDI
  MARDI
  MERCREDI
  JEUDI
  VENDREDI
  SAMEDI
  DIMANCHE
}

enum Ressenti {
  FACILE
  MOYEN
  DIFFICILE
}

enum Repetition {
  UNE_FOIS
  QUOTIDIENNE
  HEBDOMADAIRE
  MENSUELLE
}

/// Documents du dossier : bilans, comptes rendus et courriers.
enum TypeBilan {
  INITIAL
  EVOLUTION
  RENOUVELLEMENT
  FIN_DE_PRISE_EN_CHARGE
  COMPTE_RENDU_SEANCE
  COURRIER_MEDECIN
  COURRIER_ECOLE
  COURRIER_ASSURANCE
}

enum TypeSession {
  /// Session du logiciel web (cookie HttpOnly).
  WEB
  /// Jeton court de l'application mobile (en-tête Authorization).
  MOBILE_ACCES
  /// Jeton de renouvellement de l'application mobile (usage unique, rotation).
  MOBILE_RENOUVELLEMENT
}

enum OrigineElement {
  /// Proposé par les règles simples (pathologie, âge, derniers résultats).
  PROPOSITION
  /// Ajouté depuis le panneau Bibliothèque.
  BIBLIOTHEQUE
  /// Copié d'une séance passée.
  COPIE
}

enum RaisonProposition {
  /// Exercice déjà travaillé, derniers résultats bons : niveau suivant.
  NIVEAU_SUIVANT
  /// Exercice déjà travaillé : on reste au niveau en cours.
  NIVEAU_EN_COURS
  /// Exercice pas encore travaillé, de la pathologie et de l'âge du patient.
  NOUVEAU
}

enum ActionAcces {
  LECTURE
  MODIFICATION
  EXPORT
}

// ─── Cabinet et comptes ──────────────────────────────────────────────────────

model Cabinet {
  id                String   @id @default(cuid())
  nom               String
  /// Messagerie activée pour tout le cabinet (exception possible par patient : ReglagePatient).
  messagerieActivee Boolean  @default(false)
  /// Message affiché aux familles dans la messagerie (ex. « Je réponds sous 48 h »).
  horairesReponse   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  utilisateurs    User[]
  patients        Patient[]
  exercices       Exercice[]
  conseils        Conseil[]
  reponsesRapides ReponseRapide[]

  @@map("cabinet")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  motDePasseHash String
  role           Role
  prenom         String
  nom            String
  cabinetId      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cabinet           Cabinet            @relation(fields: [cabinetId], references: [id], onDelete: Restrict)
  /// Pour un PATIENT_ADULT : son propre dossier patient.
  dossierPatient    Patient?           @relation("CompteDuPatient")
  enfants           LienTuteur[]
  consentements     Consentement[]
  programmesCrees   Programme[]
  realisations      Realisation[]
  conseilsEnvoyes   EnvoiConseil[]
  conseilsLus       EnvoiConseil[]     @relation("ConseilsLus")
  plansConseil      PlanConseil[]
  seances           Seance[]
  bilans            Bilan[]
  bilansPartages    Bilan[]            @relation("BilansPartages")
  messages          Message[]
  sessions          Session[]
  invitationsCreees Invitation[]       @relation("InvitationsCreees")
  documents         Document[]
  exercicesCrees    Exercice[]         @relation("ExercicesCrees")
  favoris           Favori[]
  versionsEnvoyees  VersionProgramme[] @relation("VersionsEnvoyees")

  @@index([cabinetId, role])
  @@map("utilisateur")
}

/// Session ouverte (web ou mobile). Seule l'empreinte SHA-256 du jeton est stockée :
/// une fuite de la base ne permet pas de se connecter.
model Session {
  id                String      @id @default(cuid())
  userId            String
  type              TypeSession
  jetonHash         String      @unique
  /// Mobile : le jeton d'accès et ses jetons de renouvellement successifs partagent
  /// la même famille. Réutiliser un ancien jeton de renouvellement révoque toute la famille.
  familleId         String
  expireLe          DateTime
  revoqueLe         DateTime?
  /// Réservé à la double authentification (TOTP) : date de validation du 2e facteur.
  /// Non utilisé en version 1.
  deuxiemeFacteurLe DateTime?
  createdAt         DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familleId])
  @@map("session")
}

/// Invitation d'un parent ou d'un patient adulte : lien à usage unique, durée limitée.
/// Seule l'empreinte SHA-256 du jeton est stockée.
model Invitation {
  id         String    @id @default(cuid())
  cabinetId  String
  patientId  String
  email      String
  /// PARENT ou PATIENT_ADULT (jamais ORTHO).
  role       Role
  jetonHash  String    @unique
  expireLe   DateTime
  utiliseeLe DateTime?
  creeParId  String?
  createdAt  DateTime  @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  creePar User?   @relation("InvitationsCreees", fields: [creeParId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("invitation")
}

/// Tentatives comptées pour limiter les essais (connexion, inscription…).
/// `cle` est une empreinte HMAC (jamais l'e-mail ni l'adresse IP en clair).
model TentativeConnexion {
  id        String   @id @default(cuid())
  cle       String
  createdAt DateTime @default(now())

  @@index([cle, createdAt])
  @@map("tentative_connexion")
}

// ─── Patients ────────────────────────────────────────────────────────────────

model Patient {
  id             String   @id @default(cuid())
  cabinetId      String
  prenom         String
  nom            String
  dateNaissance  DateTime @db.Date
  notes          String?
  /// Médecin prescripteur (nom, et un moyen de contact libre : téléphone, adresse…).
  medecinNom     String?
  medecinContact String?
  /// Compte de l'application pour un patient adolescent ou adulte (null pour un enfant).
  compteUserId   String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cabinet       Cabinet             @relation(fields: [cabinetId], references: [id], onDelete: Restrict)
  compte        User?               @relation("CompteDuPatient", fields: [compteUserId], references: [id], onDelete: SetNull)
  pathologies   PatientPathologie[]
  tuteurs       LienTuteur[]
  consentements Consentement[]
  programmes    Programme[]
  envoisConseil EnvoiConseil[]
  plansConseil  PlanConseil[]
  conseils      Conseil[]
  seances       Seance[]
  bilans        Bilan[]
  filMessages   FilMessages?
  reglage       ReglagePatient?
  invitations   Invitation[]
  documents     Document[]

  @@index([cabinetId])
  @@map("patient")
}

/// Document joint au dossier (ordonnance, compte rendu…). Seule la clé de stockage
/// est en base ; le fichier est chez l'hébergeur (disque local en développement).
model Document {
  id           String   @id @default(cuid())
  patientId    String
  nomFichier   String
  typeMime     String
  tailleOctets Int
  cleStockage  String   @unique
  ajouteParId  String?
  createdAt    DateTime @default(now())

  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  ajoutePar User?   @relation(fields: [ajouteParId], references: [id], onDelete: SetNull)

  @@index([patientId, createdAt])
  @@map("document")
}

/// Pathologie(s) d'un patient (lien Patient ↔ Catégorie).
model PatientPathologie {
  patientId   String
  categorieId String

  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  categorie Categorie @relation(fields: [categorieId], references: [id], onDelete: Restrict)

  @@id([patientId, categorieId])
  @@index([categorieId])
  @@map("patient_pathologie")
}

/// Quel parent (User PARENT) est responsable de quel enfant.
model LienTuteur {
  parentId  String
  patientId String
  createdAt DateTime @default(now())

  parent  User    @relation(fields: [parentId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@id([parentId, patientId])
  @@index([patientId])
  @@map("lien_tuteur")
}

/// Preuve de consentement. Conservée si le patient est supprimé (patientId remis à null).
model Consentement {
  id           String           @id @default(cuid())
  userId       String
  patientId    String?
  type         TypeConsentement
  versionTexte String
  accordeLe    DateTime         @default(now())
  retire       Boolean          @default(false)
  retireLe     DateTime?

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([userId, type])
  @@index([patientId])
  @@map("consentement")
}

/// Exception au réglage du cabinet pour un patient. null = suit le cabinet.
model ReglagePatient {
  patientId         String   @id
  messagerieActivee Boolean?
  updatedAt         DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("reglage_patient")
}

// ─── Bibliothèque ────────────────────────────────────────────────────────────

/// Catégorie = pathologie (ex. « Langage oral »).
model Categorie {
  id   String @id @default(cuid())
  nom  String @unique
  slug String @unique

  exercices  Exercice[]
  patients   PatientPathologie[]
  etiquettes ConseilEtiquette[]

  @@map("categorie")
}

model Exercice {
  id             String   @id @default(cuid())
  categorieId    String
  /// null = exercice commun à tous ; sinon exercice propre à un cabinet.
  cabinetId      String?
  titre          String
  description    String
  ageMin         Int
  ageMax         Int
  dureeMinutes   Int
  materiel       String[]
  /// Aperçu visible sans ouvrir la fiche : image + consigne courte (+ matériel ci-dessus).
  apercuImage    String?
  apercuConsigne String
  /// Étiquette interne : contenu d'exemple NON vérifié médicalement
  /// (« à valider par un orthophoniste »). Toujours affichée tant qu'elle est vraie.
  aValider       Boolean  @default(false)
  /// Score prévu par l'exercice, « sur N » (ex. 10 pour « 7 sur 10 »). null = pas de score.
  scoreMax       Int?
  /// Orthophoniste qui a créé l'exercice (exercices du cabinet).
  auteurId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categorie Categorie          @relation(fields: [categorieId], references: [id], onDelete: Restrict)
  cabinet   Cabinet?           @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  auteur    User?              @relation("ExercicesCrees", fields: [auteurId], references: [id], onDelete: SetNull)
  niveaux   NiveauExercice[]
  elements  ElementProgramme[]
  seances   ElementSeance[]
  favoris   Favori[]

  @@index([categorieId])
  @@index([cabinetId])
  @@map("exercice")
}

/// Exercice marqué comme favori par un orthophoniste.
model Favori {
  userId     String
  exerciceId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercice Exercice @relation(fields: [exerciceId], references: [id], onDelete: Cascade)

  @@id([userId, exerciceId])
  @@index([exerciceId])
  @@map("favori")
}

/// 3 niveaux par exercice (1, 2, 3), chacun avec sa consigne.
model NiveauExercice {
  id         String @id @default(cuid())
  exerciceId String
  niveau     Int
  consigne   String

  exercice Exercice @relation(fields: [exerciceId], references: [id], onDelete: Cascade)

  @@unique([exerciceId, niveau])
  @@map("niveau_exercice")
}

// ─── Programme et réalisations ───────────────────────────────────────────────

model Programme {
  id        String    @id @default(cuid())
  patientId String
  auteurId  String?
  titre     String
  dateDebut DateTime  @db.Date
  dateFin   DateTime? @db.Date
  actif     Boolean   @default(true)
  /// Dernière modification du contenu (exercices, niveaux, rythme, mots). Comparée au
  /// dernier envoi pour savoir s'il y a des changements non envoyés.
  modifieLe DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  patient  Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  auteur   User?              @relation(fields: [auteurId], references: [id], onDelete: SetNull)
  elements ElementProgramme[]
  versions VersionProgramme[]

  @@index([patientId, actif])
  @@map("programme")
}

/// Version ENVOYÉE d'un programme : copie figée de son contenu au moment de l'envoi.
/// La famille voit toujours la dernière version ; l'orthophoniste peut continuer à
/// modifier le programme, les changements ne sont visibles qu'après un nouvel envoi.
model VersionProgramme {
  id          String   @id @default(cuid())
  programmeId String
  numero      Int
  envoyeLe    DateTime @default(now())
  envoyeParId String?
  /// Contenu figé (type ElementEnvoye[] de packages/shared/src/programme.ts).
  contenu     Json

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  envoyePar User?     @relation("VersionsEnvoyees", fields: [envoyeParId], references: [id], onDelete: SetNull)

  @@unique([programmeId, numero])
  @@map("version_programme")
}

model ElementProgramme {
  id             String        @id @default(cuid())
  programmeId    String
  exerciceId     String
  niveau         Int
  foisParSemaine Int
  jours          JourSemaine[]
  motFamille     String?
  ordre          Int           @default(0)
  /// Retiré du programme (retrait doux) : l'historique des réalisations est conservé.
  retireLe       DateTime?

  programme    Programme     @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  exercice     Exercice      @relation(fields: [exerciceId], references: [id], onDelete: Restrict)
  realisations Realisation[]

  @@index([programmeId, ordre])
  @@index([exerciceId])
  @@map("element_programme")
}

model Realisation {
  id                 String    @id @default(cuid())
  elementProgrammeId String
  /// Compte qui a saisi la réalisation (parent ou patient adulte).
  saisieParId        String?
  date               DateTime
  fait               Boolean
  ressenti           Ressenti?
  /// Score obtenu, de 0 à `scoreMax` (optionnel).
  score              Int?
  /// « Sur combien » au moment de la réalisation (copie de Exercice.scoreMax).
  scoreMax           Int?
  /// Niveau de l'exercice au moment de la réalisation (scores par niveau des bilans).
  niveau             Int?
  /// Identifiant créé par le téléphone : une réalisation renvoyée (synchronisation
  /// après une coupure réseau) n'est jamais enregistrée deux fois.
  idClient           String?
  createdAt          DateTime  @default(now())

  element         ElementProgramme @relation(fields: [elementProgrammeId], references: [id], onDelete: Cascade)
  saisiePar       User?            @relation(fields: [saisieParId], references: [id], onDelete: SetNull)
  enregistrements Enregistrement[]

  @@unique([elementProgrammeId, idClient])
  @@index([elementProgrammeId, date])
  @@map("realisation")
}

/// Fichier audio d'une réalisation. Seule la clé de stockage est en base (stockage HDS).
model Enregistrement {
  id            String   @id @default(cuid())
  realisationId String
  cleStockage   String   @unique
  typeMime      String
  dureeSecondes Int
  createdAt     DateTime @default(now())

  realisation Realisation @relation(fields: [realisationId], references: [id], onDelete: Cascade)

  @@index([realisationId])
  @@map("enregistrement")
}

// ─── Conseils ────────────────────────────────────────────────────────────────

/// Modèle pré-fait (estModele = true, étiquettes pathologie + tranche d'âge) ou conseil
/// propre à un patient (copie figée de ce qui a été envoyé : tel quel, modifié, ou écrit de zéro).
model Conseil {
  id             String   @id @default(cuid())
  titre          String
  /// Bloc « À faire » : une idée par ligne.
  aFaire         String[]
  /// Bloc « À éviter » : une idée par ligne.
  aEviter        String[]
  estModele      Boolean  @default(false)
  /// Contenu d'exemple NON vérifié médicalement (« à valider par un orthophoniste »).
  /// Reste vrai sur un conseil adapté d'un exemple.
  aValider       Boolean  @default(false)
  /// Tranche d'âge (en années) d'un modèle. null = pas de limite.
  ageMin         Int?
  ageMax         Int?
  /// null = modèle commun ; sinon propre à un cabinet.
  cabinetId      String?
  /// Rempli pour un conseil propre à un patient.
  patientId      String?
  /// Modèle dont ce conseil a été copié (tel quel ou modifié).
  modeleSourceId String?
  /// Vrai si le texte a été changé par rapport au modèle avant l'envoi.
  modifie        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cabinet      Cabinet?           @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  patient      Patient?           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  modeleSource Conseil?           @relation("Adaptation", fields: [modeleSourceId], references: [id], onDelete: SetNull)
  adaptations  Conseil[]          @relation("Adaptation")
  etiquettes   ConseilEtiquette[]
  envois       EnvoiConseil[]
  plans        PlanConseil[]

  @@index([estModele])
  @@index([patientId])
  @@index([cabinetId])
  @@map("conseil")
}

/// Étiquette pathologie d'un conseil (lien Conseil ↔ Catégorie).
model ConseilEtiquette {
  conseilId   String
  categorieId String

  conseil   Conseil   @relation(fields: [conseilId], references: [id], onDelete: Cascade)
  categorie Categorie @relation(fields: [categorieId], references: [id], onDelete: Cascade)

  @@id([conseilId, categorieId])
  @@index([categorieId])
  @@map("conseil_etiquette")
}

/// Planification de l'envoi d'un conseil : une fois (maintenant ou à une date choisie)
/// ou chaque semaine. Les envois dus sont créés à la lecture (voir docs/CONSEILS.md).
model PlanConseil {
  id            String     @id @default(cuid())
  conseilId     String
  patientId     String
  creeParId     String?
  /// UNE_FOIS ou HEBDOMADAIRE.
  repetition    Repetition
  /// Prochain envoi prévu. null = plus rien à envoyer (terminé ou arrêté).
  prochainEnvoi DateTime?
  arreteLe      DateTime?
  createdAt     DateTime   @default(now())

  conseil Conseil        @relation(fields: [conseilId], references: [id], onDelete: Cascade)
  patient Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  creePar User?          @relation(fields: [creeParId], references: [id], onDelete: SetNull)
  envois  EnvoiConseil[]

  @@index([patientId, prochainEnvoi])
  @@index([conseilId])
  @@map("plan_conseil")
}

/// Un envoi d'un conseil à la famille (un par occurrence d'une répétition), lu ou non.
model EnvoiConseil {
  id          String     @id @default(cuid())
  conseilId   String
  patientId   String
  planId      String?
  envoyeParId String?
  repetition  Repetition @default(UNE_FOIS)
  envoyeLe    DateTime   @default(now())
  /// « J'ai compris » : quand, et par quel compte famille.
  luLe        DateTime?
  luParId     String?

  conseil   Conseil      @relation(fields: [conseilId], references: [id], onDelete: Cascade)
  patient   Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  plan      PlanConseil? @relation(fields: [planId], references: [id], onDelete: SetNull)
  envoyePar User?        @relation(fields: [envoyeParId], references: [id], onDelete: SetNull)
  luPar     User?        @relation("ConseilsLus", fields: [luParId], references: [id], onDelete: SetNull)

  /// Une occurrence d'un plan n'est créée qu'une fois (lectures simultanées).
  @@unique([planId, envoyeLe])
  @@index([patientId, envoyeLe])
  @@index([conseilId])
  @@map("envoi_conseil")
}

// ─── Séances et bilans ───────────────────────────────────────────────────────

/// Séance au cabinet. Une seule séance « en préparation » par patient (termineeLe null,
/// garanti par la base) ; une fois terminée, ses notes et points à reprendre alimentent
/// le résumé de la séance suivante.
model Seance {
  id               String    @id @default(cuid())
  patientId        String
  orthoId          String?
  date             DateTime
  objectifs        String?
  /// Matériel en plus, écrit à la main (le reste est calculé à partir des exercices).
  materiel         String?
  /// Notes prises pendant ou après la séance (jamais envoyées à un service externe).
  notes            String?
  /// Points à reprendre à la séance suivante.
  pointsAReprendre String?
  /// null = en préparation ; sinon date de fin de la séance.
  termineeLe       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  patient  Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  ortho    User?           @relation(fields: [orthoId], references: [id], onDelete: SetNull)
  elements ElementSeance[]
  bilans   Bilan[]

  @@index([patientId, date])
  @@map("seance")
}

/// Exercice d'une séance au cabinet, au niveau choisi.
/// Proposé par les règles (`retenu` faux tant que l'orthophoniste ne l'a pas accepté),
/// ajouté depuis la bibliothèque, ou copié d'une séance passée.
model ElementSeance {
  id         String             @id @default(cuid())
  seanceId   String
  exerciceId String
  niveau     Int
  ordre      Int                @default(0)
  origine    OrigineElement
  /// Raison de la proposition (origine PROPOSITION seulement).
  raison     RaisonProposition?
  /// Faux : proposé, en attente de l'avis de l'orthophoniste. Vrai : fait partie de la séance.
  retenu     Boolean            @default(true)
  createdAt  DateTime           @default(now())

  seance   Seance   @relation(fields: [seanceId], references: [id], onDelete: Cascade)
  exercice Exercice @relation(fields: [exerciceId], references: [id], onDelete: Restrict)

  /// Un exercice n'apparaît qu'une fois dans une séance.
  @@unique([seanceId, exerciceId])
  @@index([exerciceId])
  @@map("element_seance")
}

/// Bilan, compte rendu ou courrier, découpé en parties (`sections`, format
/// SectionDocument[] de packages/shared/src/bilans.ts) : parties remplies
/// automatiquement depuis les données, et parties à écrire. Le statut (Rempli,
/// Automatique, À relire, À écrire) se calcule à partir des parties.
model Bilan {
  id           String    @id @default(cuid())
  patientId    String
  auteurId     String?
  type         TypeBilan
  titre        String
  /// Modèle de départ (clé dans packages/shared/src/modeles-bilans.ts).
  modele       String?
  /// Période couverte par les chiffres automatiques (début ; la fin est `date`).
  dateDebut    DateTime? @db.Date
  date         DateTime  @db.Date
  /// Compte rendu d'une séance précise.
  seanceId     String?
  /// Destinataire d'un courrier (texte libre).
  destinataire String?
  sections     Json
  /// Partagé avec la famille : seulement si l'orthophoniste l'a coché. Faux par défaut.
  partage      Boolean   @default(false)
  partageLe    DateTime?
  partageParId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  auteur     User?   @relation(fields: [auteurId], references: [id], onDelete: SetNull)
  seance     Seance? @relation(fields: [seanceId], references: [id], onDelete: SetNull)
  partagePar User?   @relation("BilansPartages", fields: [partageParId], references: [id], onDelete: SetNull)

  @@index([patientId, date])
  @@map("bilan")
}

// ─── Messagerie ──────────────────────────────────────────────────────────────

/// Conversation d'un patient : UNE par patient (avec ses parents, ou avec lui s'il est
/// majeur). L'historique reste au dossier.
model FilMessages {
  id        String   @id @default(cuid())
  patientId String   @unique
  sujet     String?
  createdAt DateTime @default(now())

  patient  Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("fil_messages")
}

model Message {
  id       String    @id @default(cuid())
  filId    String
  auteurId String?
  /// Texte (peut être vide si le message n'est qu'une pièce jointe).
  contenu  String
  envoyeLe DateTime  @default(now())
  /// Lu par l'autre côté (la famille pour un message de l'orthophoniste, et inversement).
  luLe     DateTime?

  fil           FilMessages   @relation(fields: [filId], references: [id], onDelete: Cascade)
  auteur        User?         @relation(fields: [auteurId], references: [id], onDelete: SetNull)
  piecesJointes PieceJointe[]

  @@index([filId, envoyeLe])
  @@map("message")
}

/// Photo ou message vocal joint à un message. Seule la clé de stockage est en base.
model PieceJointe {
  id            String @id @default(cuid())
  messageId     String
  nomFichier    String
  typeMime      String
  tailleOctets  Int
  cleStockage   String @unique
  /// Message vocal : durée annoncée par l'appareil (secondes).
  dureeSecondes Int?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("piece_jointe")
}

/// Réponse rapide : modèle de message du cabinet pour les questions qui reviennent.
model ReponseRapide {
  id        String   @id @default(cuid())
  cabinetId String
  titre     String
  texte     String
  ordre     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cabinet Cabinet @relation(fields: [cabinetId], references: [id], onDelete: Cascade)

  @@index([cabinetId, ordre])
  @@map("reponse_rapide")
}

// ─── Traçabilité ─────────────────────────────────────────────────────────────

/// Qui a lu quel dossier patient, quand. Pas de clé étrangère : conservé même si
/// le patient ou le compte est supprimé. Ne contient jamais de contenu médical.
model JournalAcces {
  id        String      @id @default(cuid())
  userId    String
  patientId String
  action    ActionAcces @default(LECTURE)
  /// Section consultée, ex. "fiche", "bilans".
  section   String?
  createdAt DateTime    @default(now())

  @@index([patientId, createdAt])
  @@index([userId, createdAt])
  @@map("journal_acces")
}
