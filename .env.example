# Copier ce fichier en .env (jamais versionné) puis adapter les valeurs.
# Valeurs de DÉVELOPPEMENT uniquement : aucun secret réel, aucune donnée réelle.

# Base PostgreSQL locale (docker-compose.yml)
POSTGRES_USER=ortho
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=ortho_dev
POSTGRES_PORT=5432

# Utilisée par Prisma (packages/db) et l'API (apps/web)
DATABASE_URL=postgresql://ortho:change-me-local-only@localhost:5432/ortho_dev?schema=public

# URL de l'API REST (hébergée par apps/web), appelée par l'application mobile
EXPO_PUBLIC_API_URL=http://localhost:3000/api
